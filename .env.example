# Fill only with the intended Firebase web app configuration after project/plan review.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional loopback Auth emulator URL; only honored on localhost/127.0.0.1.
VITE_FIREBASE_AUTH_EMULATOR_URL=

# Test-only Firestore emulator; honored only in development with demo-matrisync.
VITE_FIRESTORE_EMULATOR_HOST=

# Controlled local developer sharing only; also requires the fixed demo project,
# loopback hostname and Auth emulator. This does not enable cloud sharing in Bolt.
VITE_SHARING_PILOT=

# External AI is disabled. No Gemini/Tavily secret belongs in any VITE_* value.
# Future provider keys/model IDs must be configured on an authenticated backend.
